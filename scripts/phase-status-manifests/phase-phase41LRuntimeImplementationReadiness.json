    "recommendedPhaseName": "Phase 4.2A deliberately blocked Rust-host stdio runtime skeleton",
    "allowedScope": [
      "private Rust module skeletons under crates/ardyn-host",
      "pure frame parser reuse from existing Phase 4.1J and 4.1K helpers",
